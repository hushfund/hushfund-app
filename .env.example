# Ethereum Mainnet only (chain ID 1).
VITE_NETWORK=mainnet
# Hushfund backend (API + relayer). Production: https://api.hushfund.app
# Empty uses the same origin and the /api route. Use your reverse proxy for same-origin API routing.
VITE_API_URL=
# Ethereum RPC for the selected network (Alchemy/Infura/QuickNode). Public RPCs rate-limit quickly.
VITE_RPC_URL=
# Optional mainnet RPC override for ENS; otherwise VITE_RPC_URL is used.
VITE_MAINNET_RPC_URL=

# Openfort (https://dashboard.openfort.io): Project Settings > API Keys, Shield > API Keys
VITE_OPENFORT_PUBLISHABLE_KEY=
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Production: https://api.hushfund.app/api/protected-create-encryption-session
VITE_CREATE_ENCRYPTED_SESSION_ENDPOINT=/api/protected-create-encryption-session

# WalletConnect (https://cloud.reown.com) for external wallets
VITE_WALLET_CONNECT_PROJECT_ID=


# Footer links
VITE_DOCS_URL=
VITE_GUIDE_URL=
VITE_X_URL=
